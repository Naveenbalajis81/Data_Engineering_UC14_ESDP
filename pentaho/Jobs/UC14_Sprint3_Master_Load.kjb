    <entry>
      <name>Empty DW</name>
      <description/>
      <type>SQL</type>
      <attributes/>
      <sql>TRUNCATE dw.fact_sales, dw.fact_finance_gl, dw.fact_procurement, dw.fact_production,
         dw.fact_inventory_movement, dw.fact_payroll,
         dw.dim_company, dw.dim_cost_center, dw.dim_customer, dw.dim_department,
         dw.dim_employee, dw.dim_material, dw.dim_product, dw.dim_vendor,
         dw.dim_warehouse, dw.dim_work_center
RESTART IDENTITY CASCADE;</sql>
      <useVariableSubstitution>F</useVariableSubstitution>
      <sqlfromfile>F</sqlfromfile>
      <sqlfilename/>
      <sendOneStatement>F</sendOneStatement>
      <connection>UC_14</connection>
      <parallel>N</parallel>
