    <connection>UC_14</connection>
    <sql>SELECT
    p.payroll_id,
    e.employee_key,
    d.date_key,
    p.pay_period,
    p.gross_pay,
    p.deductions,
    p.net_pay
FROM staging.hcm_payroll p

INNER JOIN dw.dim_employee e
    ON p.employee_id = e.employee_id

INNER JOIN dw.dim_date d
    ON p.pay_date = d.full_date
WHERE CAST(? AS text) = 'go'</sql>
