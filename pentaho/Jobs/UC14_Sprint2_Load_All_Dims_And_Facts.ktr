<transformation>
  <info>
    <name>UC14_Sprint2_Load_All_Dims_And_Facts</name>
    <description>All 16 Sprint 2 dw loads in one transformation. The 10 dimensions run in parallel; each fact waits until every dimension Table output has finished.</description>
