  <step>
    <name>Sales: Table input</name>
    <type>TableInput</type>
    <description />
    <distribute>Y</distribute>
    <custom_distribution />
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
    <connection>UC_14</connection>
    <sql>SELECT
    oi.order_id,
    oi.order_item_id,

    d.date_key,

    c.customer_key,

    p.product_key,

    v.vendor_key,

    oi.price,
    oi.freight_value

FROM staging.olist_order_items oi

INNER JOIN staging.olist_orders o
    ON oi.order_id = o.order_id

INNER JOIN dw.dim_customer c
    ON o.customer_id = c.customer_id

INNER JOIN dw.dim_product p
    ON oi.product_id = p.product_id

INNER JOIN dw.dim_vendor v
    ON oi.seller_id = v.seller_id

INNER JOIN dw.dim_date d
    ON DATE(o.order_purchase_timestamp) = d.full_date
WHERE CAST(? AS text) = 'go'</sql>
    <limit>0</limit>
    <lookup>Gate Sales: wait for all dimensions</lookup>
    <execute_each_row>Y</execute_each_row>
    <variables_active>N</variables_active>
