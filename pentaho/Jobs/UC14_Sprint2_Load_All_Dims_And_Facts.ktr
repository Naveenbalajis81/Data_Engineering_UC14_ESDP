  <step>
    <name>Production: Read Production Orders</name>
    <type>TableInput</type>
    <description />
    <distribute>Y</distribute>
    <custom_distribution />
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
    <connection>UC_14</connection>
    <sql>SELECT
    po.production_order_id,
    d.date_key,
    m.material_key,
    wc.work_center_key,
    po.plant,
    po.order_quantity,
    po.status
FROM staging.pp_production_orders po

INNER JOIN dw.dim_material m
    ON po.material_id = m.material_id

INNER JOIN dw.dim_work_center wc
    ON po.work_center_id = wc.work_center_id

INNER JOIN dw.dim_date d
    ON po.planned_start_date = d.full_date
WHERE CAST(? AS text) = 'go'</sql>
    <limit>0</limit>
    <lookup>Gate Production: wait for all dimensions</lookup>
    <execute_each_row>Y</execute_each_row>
    <variables_active>N</variables_active>
