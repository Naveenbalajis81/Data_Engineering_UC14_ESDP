    <connection>UC_14</connection>
    <sql>SELECT
    wm.movement_id,
    wm.material_id,
    w.warehouse_key,
    p.product_key,
    d.date_key,
    wm.movement_type,
    wm.quantity,
    wm.reference_document

FROM staging.wm_stock_movements wm

INNER JOIN dw.dim_warehouse w
    ON wm.warehouse_id = w.warehouse_id

INNER JOIN staging.mm_material_master mm
    ON wm.material_id = mm.material_id

INNER JOIN dw.dim_product p
    ON mm.product_id = p.product_id

INNER JOIN dw.dim_date d
    ON wm.movement_date = d.full_date
WHERE CAST(? AS text) = 'go'</sql>
