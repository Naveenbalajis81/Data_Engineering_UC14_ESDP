  <step>
    <name>Finance_GL: Read Finance GL</name>
    <type>TableInput</type>
    <description />
    <distribute>Y</distribute>
    <custom_distribution />
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
    <connection>UC_14</connection>
    <sql>SELECT
    ji.document_number,
    ji.line_item,
    dd.date_key,
    dc.company_key,
    dcc.cost_center_key,
    ji.gl_account,
    ji.debit_credit_indicator,
    ji.amount,
    ji.profit_center,
    ji.order_id,
    je.currency,
    je.document_type
FROM staging.fi_journal_entry_items ji
JOIN staging.fi_journal_entries je
    ON ji.document_number = je.document_number
LEFT JOIN dw.dim_date dd
    ON dd.full_date = CAST(je.posting_date AS DATE)
LEFT JOIN dw.dim_company dc
    ON dc.company_code = je.company_code
LEFT JOIN dw.dim_cost_center dcc
    ON dcc.cost_center = ji.cost_center
WHERE CAST(? AS text) = 'go'</sql>
    <limit>0</limit>
    <lookup>Gate Finance_GL: wait for all dimensions</lookup>
    <execute_each_row>Y</execute_each_row>
    <variables_active>N</variables_active>
    <lazy_conversion_active>N</lazy_conversion_active>
    <cached_row_meta_active>N</cached_row_meta_active>
