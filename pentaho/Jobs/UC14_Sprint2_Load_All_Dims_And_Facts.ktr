  <step>
    <name>Procurement: Table input</name>
    <type>TableInput</type>
    <description />
    <distribute>Y</distribute>
    <custom_distribution />
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
    <connection>UC_14</connection>
    <sql>SELECT
    poi.po_id,
    poi.po_item,
    d.date_key,
    v.vendor_key,
    p.product_key,
    c.company_key,
    poi.plant,
    poi.quantity,
    poi.unit_price,
    (poi.quantity * poi.unit_price) AS total_amount,
    po.currency

FROM staging.mm_purchase_order_items poi

INNER JOIN staging.mm_purchase_orders po
    ON poi.po_id = po.po_id

INNER JOIN dw.dim_vendor v
    ON po.vendor_id = v.vendor_id

INNER JOIN staging.mm_material_master mm
    ON poi.material_id = mm.material_id

INNER JOIN dw.dim_product p
    ON mm.product_id = p.product_id

INNER JOIN dw.dim_company c
    ON REGEXP_REPLACE(TRIM(po.company_code), '\.0+$', '') =
       TRIM(c.company_code)

INNER JOIN dw.dim_date d
    ON po.po_date = d.full_date
WHERE CAST(? AS text) = 'go'</sql>
    <limit>0</limit>
    <lookup>Gate Procurement: wait for all dimensions</lookup>
    <execute_each_row>Y</execute_each_row>
    <variables_active>N</variables_active>
    <lazy_conversion_active>N</lazy_conversion_active>
